# Midwicket environment example
# Copy this file to .env and replace placeholder values.

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Generate a strong random value, for example:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
MIDWICKET_SECRET_KEY=replace-with-random-secret

# Docker compose compatibility variable.
# Keep this value the same as MIDWICKET_SECRET_KEY.
SECRET_KEY=replace-with-same-value-as-MIDWICKET_SECRET_KEY

# API key authentication (recommended true for all non-test environments)
MIDWICKET_API_KEY_REQUIRED=true

# Comma-separated API keys, no spaces.
# Example: key-one,key-two
MIDWICKET_API_KEYS=replace-with-one-or-more-api-keys

# -----------------------------------------------------------------------------
# API / Network
# -----------------------------------------------------------------------------
MIDWICKET_ENV=development
MIDWICKET_API_HOST=0.0.0.0
MIDWICKET_API_PORT=8000

# Comma-separated origins. Empty means browsers cannot call API cross-origin.
MIDWICKET_CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Comma-separated allowed Host headers.
MIDWICKET_ALLOWED_HOSTS=localhost,127.0.0.1

# Bind host for live webhook HTTP listener.
MIDWICKET_WEBHOOK_HOST=localhost

# Trust X-Forwarded-For only when peer IP matches these CIDRs/IPs.
# Example: 127.0.0.1,10.0.0.0/8
MIDWICKET_TRUSTED_PROXIES=

# Keep disabled unless you explicitly need ad-hoc SQL endpoint.
MIDWICKET_ANALYZE_ENABLED=false
# Maximum analyze query runtime in seconds (1..120).
MIDWICKET_ANALYZE_TIMEOUT_SECONDS=8

# -----------------------------------------------------------------------------
# Data / Runtime
# -----------------------------------------------------------------------------
MIDWICKET_DATA_DIR=./data
MIDWICKET_DB_THREADS=4
MIDWICKET_DB_MEMORY=2GB
MIDWICKET_CACHE_TTL=3600
CRICSHEET_URL=https://cricsheet.org/downloads/ipl_json.zip

# -----------------------------------------------------------------------------
# Docker compose extras
# -----------------------------------------------------------------------------
GRAFANA_PASSWORD=replace-with-strong-grafana-password

# -----------------------------------------------------------------------------
# Optional plugin controls (advanced)
# -----------------------------------------------------------------------------
# Comma-separated allowed module prefixes for plugin loading.
MIDWICKET_PLUGIN_ALLOWLIST=

# Comma-separated plugin module paths.
# In production, prefer leaving this empty.
MIDWICKET_PLUGINS=

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO